#!/bin/bash
###############################################################################
# Target runner for the irace-evo example: a BRKGA for the Longest Run
# Subsequence (LRS) problem, whose function order_chromosome() is evolved.
#
# irace calls it as:
#   target-runner <config_id> <instance_id> <seed> <instance> [parameters...]
# and reads one number from its standard output: the cost to minimise.
#
# Which program runs:
#   irace-evo pairs each configuration with a code variant and writes the
#   pairing to .irace_evo_variants.csv (config_id,executable_path,variant_id).
#   A configuration listed there runs its variant; any other configuration
#   (and plain irace, without the file) runs the original, ./bin/brkga,
#   compiled from src/brkga.cpp when needed. Nothing is ever deleted here:
#   a variant whose program is missing gets the penalty cost, and the reason
#   goes to standard error.
#
# Environment:
#   MAXIMIZE    1 (default): the program prints a score to maximise (the
#               length found for LRS), so its negative is returned. Set 0 for
#               a program that prints a cost to minimise.
#   TIME_LIMIT  seconds per run (default 120; the tests use 1).
#   RUN_LOG     if set, a file where each run appends config_id,executable.
#   DEBUG       1 to print what happens to standard error.
###############################################################################
set -u
MAXIMIZE=${MAXIMIZE:-1}
PENALTY=999999

error() { echo "$(TZ=UTC date): $0: error: $*" >&2; exit 1; }
debug() { [ "${DEBUG:-0}" = "1" ] && echo "$(TZ=UTC date): $0: debug: $*" >&2; return 0; }
penalty() { debug "penalty: $*"; echo "$0: $*" >&2; echo "$PENALTY"; exit 0; }

CONFIG_ID=$1
INSTANCE_ID=$2
SEED=$3
INSTANCE=$4
shift 4 || error "Not enough parameters"
CONFIG_PARAMS=$*

[ -f "$INSTANCE" ] || error "Instance file not found: $INSTANCE"

# Compile the original once, under a lock so parallel runs do not race.
ORIGINAL=./bin/brkga
if [ ! -x "$ORIGINAL" ] || [ src/brkga.cpp -nt "$ORIGINAL" ]; then
    mkdir -p bin
    while ! mkdir bin/.compile.lock 2>/dev/null; do sleep 1; done
    if [ ! -x "$ORIGINAL" ] || [ src/brkga.cpp -nt "$ORIGINAL" ]; then
        g++ -O3 -std=c++17 -Wall src/brkga.cpp -o "$ORIGINAL" 2>/dev/null
    fi
    rmdir bin/.compile.lock
    [ -x "$ORIGINAL" ] || error "Compiling src/brkga.cpp failed"
fi

EXECUTABLE=$ORIGINAL
MAP=.irace_evo_variants.csv
if [ -s "$MAP" ]; then
    MAPPED=$(awk -F',' -v id="$CONFIG_ID" '$1 == id { gsub(/"/, "", $2); print $2; exit }' "$MAP")
    if [ -n "$MAPPED" ]; then
        EXECUTABLE=$MAPPED
        [ -x "$EXECUTABLE" ] || penalty "configuration $CONFIG_ID is paired with $EXECUTABLE, which is missing"
    fi
fi
[ -n "${RUN_LOG:-}" ] && echo "$CONFIG_ID,$EXECUTABLE" >> "$RUN_LOG"
debug "configuration $CONFIG_ID runs $EXECUTABLE"

STDOUT=c${CONFIG_ID}-${INSTANCE_ID}-${SEED}.stdout
STDERR=c${CONFIG_ID}-${INSTANCE_ID}-${SEED}.stderr
LIMIT=${TIME_LIMIT:-120}
# A variant may loop forever; give it the time limit plus a margin.
timeout $((LIMIT * 2 + 10)) "$EXECUTABLE" -i "$INSTANCE" $CONFIG_PARAMS -t "$LIMIT" -tuning > "$STDOUT" 2> "$STDERR"
RETVAL=$?
trap 'rm -f "$STDOUT" "$STDERR"' EXIT

[ $RETVAL -eq 124 ] && penalty "configuration $CONFIG_ID timed out"
[ $RETVAL -ne 0 ] && penalty "configuration $CONFIG_ID exited with status $RETVAL: $(head -c 200 "$STDERR")"
COST=$(head -n 1 "$STDOUT" | grep -oE '^[[:space:]]*-?[0-9]+(\.[0-9]+)?' | tr -d '[:space:]')
[ -n "$COST" ] || penalty "configuration $CONFIG_ID printed no cost: $(head -c 200 "$STDOUT")"

if [ "$MAXIMIZE" = "1" ]; then
    echo "-$COST" | sed 's/^--//'
else
    echo "$COST"
fi
