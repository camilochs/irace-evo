#!/bin/bash
###############################################################################
# irace-evo target runner template. Copy it next to your scenario, make it
# executable, and edit the three lines marked EDIT.
#
# irace calls it as:
#   target-runner <config_id> <instance_id> <seed> <instance> [parameters...]
# and reads one number from its standard output: the cost to minimise.
# irace reads standard error too: anything there besides the cost stops it,
# so every message of this script goes to target-runner.log.
#
# Which program runs: irace-evo pairs each configuration with a code variant
# in .irace_evo_variants.csv (config_id,executable_path,variant_id). A
# configuration listed there runs its variant; any other one runs ORIGINAL.
#
# A variant that is missing, crashes, prints no cost or runs past the CPU
# limit gets the PENALTY cost (the paper: runtime errors are penalised); the
# run goes on.
###############################################################################
set -u
ORIGINAL=./bin/my-algorithm   # EDIT: your compiled original program
PENALTY=999999                # EDIT: a cost worse than any real one
LIMIT=${TIME_LIMIT:-60}       # EDIT: seconds of CPU a run may use

log() { echo "$(TZ=UTC date): $*" >> target-runner.log; }
penalty() { log "$*"; echo "$PENALTY"; exit 0; }

CONFIG_ID=$1; INSTANCE_ID=$2; SEED=$3; INSTANCE=$4
shift 4 || { echo "target-runner: not enough arguments" >&2; exit 1; }

EXECUTABLE=$ORIGINAL
if [ -s .irace_evo_variants.csv ]; then
    MAPPED=$(awk -F',' -v id="$CONFIG_ID" '$1 == id { gsub(/"/, "", $2); print $2; exit }' .irace_evo_variants.csv)
    if [ -n "$MAPPED" ]; then
        EXECUTABLE=$MAPPED
        [ -x "$EXECUTABLE" ] || penalty "configuration $CONFIG_ID is paired with $EXECUTABLE, which is missing"
    fi
fi

STDOUT=c${CONFIG_ID}-${INSTANCE_ID}-${SEED}.stdout
STDERR=c${CONFIG_ID}-${INSTANCE_ID}-${SEED}.stderr
trap 'rm -f "$STDOUT" "$STDERR"' EXIT
# CPU limit for a variant that loops forever; a wall-clock limit as well
# when timeout (or gtimeout on macOS) exists. The outer 2>/dev/null
# silences bash's notice when the program dies by a signal.
WALL=$(command -v timeout || command -v gtimeout || true)
# EDIT the command line below to your program's options.
{ ( ulimit -t $((LIMIT * 2 + 10)); exec ${WALL:+$WALL $((LIMIT * 20 + 60))} "$EXECUTABLE" --instance "$INSTANCE" --seed "$SEED" "$@" ) > "$STDOUT" 2> "$STDERR"
  RETVAL=$?; } 2> /dev/null

[ $RETVAL -eq 124 ] && penalty "configuration $CONFIG_ID hung"
[ $RETVAL -eq 152 ] || [ $RETVAL -eq 137 ] && penalty "configuration $CONFIG_ID used more than $((LIMIT * 2 + 10)) s of CPU"
[ $RETVAL -gt 128 ] && penalty "configuration $CONFIG_ID was killed by signal $((RETVAL - 128))"
[ $RETVAL -ne 0 ] && penalty "configuration $CONFIG_ID exited with status $RETVAL: $(head -c 200 "$STDERR")"
# The cost: the first number on the last line of output.
COST=$(tail -n 1 "$STDOUT" | grep -oE '[+-]?[0-9]*\.?[0-9]+([eE][+-]?[0-9]+)?' | head -n 1)
[ -n "$COST" ] || penalty "configuration $CONFIG_ID printed no cost: $(tail -c 200 "$STDOUT")"
echo "$COST"
